# ORACLE Environment Configuration Template
PROJECT_NAME="ORACLE - Autonomous Enterprise Decision Intelligence Engine"
ENVIRONMENT="development"
PORT=8000

# Database Configuration (Defaults to local SQLite WAL, can be replaced with PostgreSQL)
DATABASE_URL="sqlite:///./data/oracle.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/oracle_db"

# LLM Configuration (Groq / Gemini)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_PRIMARY_MODEL="llama-3.3-70b-versatile"
GROQ_FALLBACK_MODEL="llama-3.1-8b-instant"

GEMINI_API_KEY=""

# Security & JWT Auth
SECRET_KEY="replace-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
